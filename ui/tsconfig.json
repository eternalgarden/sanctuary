{
    // More info on tsconfig
    // https://www.typescriptlang.org/docs/handbook/tsconfig-json.html
    "compilerOptions": {
      "pretty": true,
      "target": "es2022",
      "module": "ESNext",
      "moduleResolution": "node",
      "importHelpers": true,
      "experimentalDecorators": true,
      // FAST's @observable/@attr fields carry initialisers; with define semantics those
      // would shadow the decorator's accessors, so keep the legacy assignment behaviour
      "useDefineForClassFields": false,
      // Vite transpiles, tsc only typechecks
      "noEmit": true,
      // emoji-mart ships broken .d.ts files (unresolvable imports), nothing we can fix
      "skipLibCheck": true,
      "allowSyntheticDefaultImports": true,
      "esModuleInterop": true,
      "noEmitOnError": true,
      "strict": true,
      "strictPropertyInitialization": false,
      "lib": [
        "dom",
        "esnext"
      ],
    },
    "include": [
      "src",
      /* pffff, so how the hell are images handled in the end */
      "./typings/common-typings.d.ts",
      "./typings/images-import.d.ts",
      "./typings/fonts-import.d.ts"
    ],
  }