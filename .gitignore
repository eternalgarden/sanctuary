# 🐖 Custom .gitignore

# 🐖 Directories
**/node_modules/
build/

# 🐖 Blender stuff
*.blend1
goblend.log

# 🐖 DEFAULT GODOT .gitignore
# Godot 4+ specific ignores
.godot/
.nomedia

# 🐖 Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# 🐖 Godot baked GI data (build artifacts - regenerate by re-baking, see rebake plan)
*.VoxelGI_data.res
*.lmbake

# 🐖 godot-cef native binaries (~2.5 GB, fetch with sanctuary/moon/tools/fetch_godot_cef.sh)
sanctuary/addons/godot_cef/bin/

# 🐖 Imported translations (automatically generated from CSV files)
*.translation

# 🐖 Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# 🐖 Python tooling
py-tools/.venv/
py-tools/__pycache__/

# 🐖 Obsidian ignore
# Ignore volatile UI-related state
**/.obsidian/workspace.json
**/.obsidian/app.json
**/.DS_Store
**/Thumbs.db
